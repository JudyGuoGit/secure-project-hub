type Permission {
  id: ID!
  name: String!
  description: String
  resource: String!
  action: String!
  createdAt: DateTime
  updatedAt: DateTime

  roles: [Role!]!
}

input CreatePermissionInput {
  name: String!
  description: String
  resource: String!
  action: String!
}

input UpdatePermissionInput {
  name: String
  description: String
  resource: String
  action: String
}
